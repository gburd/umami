use umami::{tokenize, TokenType};

let toks = tokenize(\[dq]level=info msg=started host=node01 count=42\[dq]);
for t in &toks {
    if t.is_parameter() {
        println!(\[dq]param: {}\[dq], t.text); // node01, 42
    }
}
