.IP
.EX
use umami::{Detector, DetectorConfig, Tokenizer};

let mut cfg = DetectorConfig::default();
cfg.tokenizer = Tokenizer::Legacy;
cfg.detect_parameter_changes = true;
let mut det = Detector::with_config(cfg);
.EE
