.SH EXAMPLES
.SS Minimal detector
.IP
.EX
use umami::Detector;

let mut det = Detector::new();
// NeverBeforeSeen on first encounter
assert!(det.observe(\[dq]host1\[dq], \[dq]service restarted\[dq], 0).is_some());
// Filtered on repeat (same structure, different nothing)
assert!(det.observe(\[dq]host1\[dq], \[dq]service restarted\[dq], 1).is_none());
.EE
